    "expected": [
      { "type": "cluster", "key": "z9:1706:931", "count": 2, "lat": 16.0005, "lng": 120.0005, "bounds": { "minLat": 16, "maxLat": 16.001, "minLng": 120, "maxLng": 120.001 }, "ids": ["spot-a", "spot-b"], "hasQuest": false },
      { "type": "point", "id": "quest-pinned" }
    ]
  },
  {
    "name": "points across a grid boundary remain separate",
    "zoom": 9,
    "points": [
      { "id": "spot-west", "kind": "spot", "lat": 16, "lng": 120.058, "pinned": false },
