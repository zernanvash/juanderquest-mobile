    ]
  },
  {
    "name": "the same destinations stay separate at z16",
    "zoom": 16,
    "points": [
      { "id": "spot-a", "kind": "spot", "lat": 16, "lng": 120, "pinned": false },
      { "id": "spot-b", "kind": "spot", "lat": 16.001, "lng": 120.001, "pinned": false },
      { "id": "spot-c", "kind": "spot", "lat": 16.002, "lng": 120.002, "pinned": false }
    ],
    "expected": [
      { "type": "point", "id": "spot-a" },
      { "type": "point", "id": "spot-b" },
      { "type": "point", "id": "spot-c" }
    ]
  },
  {
    "name": "pinned quest stays separate from nearby unpinned spots",
    "zoom": 9,
    "points": [
      { "id": "spot-a", "kind": "spot", "lat": 16, "lng": 120, "pinned": false },
      { "id": "spot-b", "kind": "spot", "lat": 16.001, "lng": 120.001, "pinned": false },
